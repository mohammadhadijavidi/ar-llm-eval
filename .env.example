# Copy to .env and fill in only the providers you use. Never commit .env.

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (one key, many models: Qwen, Llama, Jais, Gemma, ...)
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Local servers (no key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Request settings
# AR_EVAL_TIMEOUT=120
# AR_EVAL_RETRIES=3
